{
  "name": "calccode",
  "displayName": "Calc Code (CentralSquare payroll)",
  "description": "Editor for CentralSquare Finance Enterprise payroll calc code: syntax coloring, cluster and attribute library with hover and completion, syntax checking, formatter, snippets and a bundled cluster reference.",
  "version": "0.10.0",
  "publisher": "CityofMukilteo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mukilteowa-gov/vscode-calccode.git"
  },
  "bugs": {
    "url": "https://github.com/mukilteowa-gov/vscode-calccode/issues"
  },
  "homepage": "https://github.com/mukilteowa-gov/vscode-calccode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "CentralSquare",
    "Finance Enterprise",
    "payroll",
    "calc code"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "calccode",
        "aliases": [
          "Calc Code",
          "calccode"
        ],
        "extensions": [
          ".calc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "calccode",
        "scopeName": "source.calccode",
        "path": "./syntaxes/calccode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "calccode",
        "path": "./snippets/calccode.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "calccode.openReference",
        "title": "Calc Code: Open cluster & attribute reference",
        "category": "Calc Code"
      },
      {
        "command": "calccode.lintFile",
        "title": "Calc Code: Check current file",
        "category": "Calc Code"
      },
      {
        "command": "calccode.lintWorkspace",
        "title": "Calc Code: Check all calc files",
        "category": "Calc Code"
      },
      {
        "command": "calccode.importExport",
        "title": "Calc Code: Import calc codes from a report export",
        "category": "Calc Code"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "calccode.lintFile",
          "when": "editorLangId == calccode"
        }
      ],
      "editor/context": [
        {
          "command": "calccode.openReference",
          "when": "editorLangId == calccode",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Calc Code",
      "properties": {
        "calccode.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check .calc files as you type and show diagnostics."
        },
        "calccode.lint.unknownNameSeverity": {
          "type": "string",
          "enum": [
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for a cluster or attribute name that is not in the bundled library. Sites can define their own clusters, so this is a warning by default."
        },
        "calccode.lint.loadUncheckedSeverity": {
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ],
          "default": "hint",
          "description": "Severity for a LOAD that is not followed by an MSCX.STATUS check."
        },
        "calccode.lint.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Turn a check off or change its severity, by rule code. The code is the word in brackets at the end of a finding, such as `[tab]`. Example: `{ \"tab\": \"off\", \"load-unchecked\": \"warning\", \"uninit\": \"hint\" }`. A severity here applies to every finding of that rule and wins over the two settings above.",
          "properties": {
            "width": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "line over 58 characters (the editor wraps the 59th and merges tokens)"
            },
            "tab": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "tab character"
            },
            "corrupt": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "paste corruption such as PYPX.BEG1DO, HOURSX, ENDIFIF"
            },
            "comment": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "comment never closed, or a stray >>"
            },
            "block": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "IF/ELSE/ENDIF and DO/UNTIL structure"
            },
            "syntax": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "statements that are not calc code"
            },
            "operator": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "words and operators from other languages: ==, !=, THEN, ELSEIF, ENDDO"
            },
            "assign-eq": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "= used where := is meant"
            },
            "lhs": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "assignment to something that cannot be assigned"
            },
            "paren": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "unmatched parentheses"
            },
            "quote": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "string not closed on its line"
            },
            "cluster-unknown": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "cluster name not in the library"
            },
            "attr-unknown": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "attribute name not in the library"
            },
            "array-index": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "{n} missing, out of range, or used on a scalar"
            },
            "load-form": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "LOAD with a key other than the documented one"
            },
            "load-unchecked": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "LOAD not followed by an MSCX.STATUS check"
            },
            "goto": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "GOTO to a missing label, labels never used"
            },
            "type": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "NVAR and CVAR type mix-ups"
            },
            "round-arg": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "ROUND on something that is not an NVAR"
            },
            "rate-round": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "a rounded register assigned to .RATE"
            },
            "uninit": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "register read but never assigned"
            },
            "unknown-word": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ],
              "description": "unknown function, or a bare word"
            }
          },
          "additionalProperties": false
        },
        "calccode.import.filePattern": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your own file layout for Calc Code: Import calc codes, offered first in the layout list. Placeholders: `${cdh}` the CDH number, `${label}` a label asked for at each import (prod, test), `${type}` a folder per kind of CDH, `${title}` the CDH title when the export has one. Folders with `/`. Example: `${type}/${cdh}/${label}.calc`. Must contain `${cdh}`."
        },
        "calccode.import.typeFolders": {
          "type": "object",
          "default": {
            "1": "PYUPCC",
            "2": "PYUPDD",
            "3": "PYUPHH"
          },
          "markdownDescription": "Folder names for `${type}` in an import layout, by the first digit of the CDH number (1 contributions, 2 deductions, 3 hours). Add `other` for anything else. Example: `{ \"1\": \"contributions\", \"2\": \"deductions\", \"3\": \"hours\" }`.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "calccode.library.extraClusters": {
          "type": "object",
          "default": {},
          "markdownDescription": "Site-specific clusters and attributes to add to the bundled library. Keys are 4-character cluster names. Example: `{ \"XYZM\": { \"desc\": \"Our custom master\", \"attrs\": { \"CD\": { \"desc\": \"code\" }, \"VAL\": { \"desc\": \"values\", \"n\": 10 } } } }`. Attributes added to an existing cluster are merged in.",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "configurationDefaults": {
      "[calccode]": {
        "editor.rulers": [
          58
        ],
        "editor.wordWrap": "off",
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      }
    }
  },
  "scripts": {
    "compile": "bun x esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node16",
    "watch": "bun x esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node16 --sourcemap --watch",
    "test": "bun test/format.test.ts && bun test/lint.test.ts && bun test/import.test.ts",
    "package": "bun run test && bun run compile && bun --bun node_modules/@vscode/vsce/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
