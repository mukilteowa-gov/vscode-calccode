{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Calc Code",
  "scopeName": "source.calccode",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#label" },
    { "include": "#record" },
    { "include": "#function" },
    { "include": "#keyword" },
    { "include": "#logical" },
    { "include": "#variable" },
    { "include": "#substring" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.calccode",
      "begin": "<<",
      "end": ">>",
      "patterns": [
        { "name": "constant.character.escape.box.calccode", "match": "[*=]{2,}" }
      ]
    },
    "string": {
      "name": "string.quoted.double.calccode",
      "begin": "\"",
      "end": "\"|$"
    },
    "label": {
      "comment": "a bare identifier alone on a line is a GOTO target",
      "match": "^\\s*(?!(?:IF|ELSE|ENDIF|DO|UNTIL|GOTO|STOP|AND|OR|NOT|LOAD|WARN|ROUND[0-9]|TRUNC[0-9])\\s*$)([A-Z][A-Z0-9_]*)\\s*$",
      "captures": { "1": { "name": "entity.name.label.calccode" } }
    },
    "record": {
      "comment": "CLUSTER.ATTR{n} — any 4-char cluster; the linter decides whether it exists",
      "match": "\\b([A-Z][A-Z0-9]{3})(\\.)([A-Za-z][A-Za-z0-9]*)(?:\\s*(\\{)([^}]*)(\\}))?",
      "captures": {
        "1": { "name": "support.class.record.calccode" },
        "2": { "name": "punctuation.accessor.calccode" },
        "3": { "name": "support.variable.field.calccode" },
        "4": { "name": "punctuation.definition.index.begin.calccode" },
        "5": { "name": "constant.numeric.index.calccode" },
        "6": { "name": "punctuation.definition.index.end.calccode" }
      }
    },
    "function": {
      "match": "\\b(LOAD|WARN|ROUND[0-9]|TRUNC[0-9])\\b(?=\\s*\\()",
      "captures": { "1": { "name": "support.function.calccode" } }
    },
    "keyword": {
      "name": "keyword.control.calccode",
      "match": "\\b(IF|ELSE|ENDIF|DO|UNTIL|GOTO|STOP)\\b"
    },
    "logical": {
      "name": "keyword.operator.logical.calccode",
      "match": "\\b(AND|OR|NOT)\\b"
    },
    "variable": {
      "match": "\\b(NVAR[0-9])\\b|\\b(CVAR[0-9])\\b",
      "captures": {
        "1": { "name": "variable.other.numeric.calccode" },
        "2": { "name": "variable.other.character.calccode" }
      }
    },
    "substring": {
      "comment": "CVARn[start,len]",
      "match": "(\\[)\\s*([0-9]+)\\s*(,)\\s*([0-9]+)\\s*(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.substring.begin.calccode" },
        "2": { "name": "constant.numeric.calccode" },
        "3": { "name": "punctuation.separator.calccode" },
        "4": { "name": "constant.numeric.calccode" },
        "5": { "name": "punctuation.definition.substring.end.calccode" }
      }
    },
    "number": {
      "name": "constant.numeric.calccode",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operator": {
      "match": "(:=)|(<>|>=|<=|[=<>])|([+\\-*/])",
      "captures": {
        "1": { "name": "keyword.operator.assignment.calccode" },
        "2": { "name": "keyword.operator.comparison.calccode" },
        "3": { "name": "keyword.operator.arithmetic.calccode" }
      }
    }
  }
}
